<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_void }}">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}
    {% render 'meta-tags' %}

    <link rel="preload" href="{{ 'bodoni-moda.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{ 'instrument-sans.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>

    {% render 'theme-styles' %}
    {{ 'snatch.css' | asset_url | stylesheet_tag }}

    <script>
      document.documentElement.classList.replace('no-js', 'js');
      (function () {
        var d = document.documentElement;
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce) d.classList.add('reduce-motion');
        window.__snatchBooted = false;
        setTimeout(function () { if (!window.__snatchBooted) d.classList.add('js-failsafe'); }, 6000);
        {%- if settings.preloader and request.design_mode == false %}
        try {
          if (!reduce && !sessionStorage.getItem('snatch:curtain')) d.classList.add('is-curtain');
        } catch (e) {}
        {%- endif %}
      })();
      window.SNATCH = {
        moneyFormat: {{ shop.money_format | json }},
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          cartUpdate: {{ routes.cart_update_url | json }},
          search: {{ routes.search_url | json }},
          predictive: {{ routes.predictive_search_url | json }},
          recommendations: {{ routes.product_recommendations_url | json }}
        },
        settings: {
          smoothScroll: {{ settings.smooth_scroll | json }},
          groupColorways: {{ settings.group_colorways | json }}
        },
        strings: {
          added: {{ 'products.added' | t | json }},
          adding: {{ 'products.adding' | t | json }},
          addToBag: {{ 'products.add_to_bag' | t | json }},
          soldOut: {{ 'products.sold_out' | t | json }},
          error: {{ 'products.error' | t | json }},
          cartUpdated: {{ 'cart.updated' | t | json }},
          remove: {{ 'cart.remove' | t | json }},
          decrease: {{ 'products.decrease' | t | json }},
          increase: {{ 'products.increase' | t | json }},
          quantity: {{ 'products.quantity' | t | json }},
          products: {{ 'search.products' | t | json }},
          viewAll: {{ 'general.view_all' | t | json }},
          noResults: {{ 'search.no_results' | t: terms: '__TERMS__' | json }},
          pause: {{ 'general.pause' | t | json }},
          play: {{ 'general.play' | t | json }}
        }
      };
    </script>

    <script src="{{ 'gsap.min.js' | asset_url }}" defer></script>
    <script src="{{ 'ScrollTrigger.min.js' | asset_url }}" defer></script>
    {%- if settings.smooth_scroll -%}
      <script src="{{ 'lenis.min.js' | asset_url }}" defer></script>
    {%- endif -%}
    <script src="{{ 'snatch.js' | asset_url }}" defer></script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name }}{% if template.suffix %} template-{{ template.name }}--{{ template.suffix }}{% endif %}">
    <a class="skip-link" href="#MainContent">{{ 'general.skip_to_content' | t }}</a>

    {%- if settings.preloader and request.design_mode == false -%}
      {% render 'curtain' %}
    {%- endif -%}

    {% sections 'header-group' %}

    <main id="MainContent" class="main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'cart-drawer' %}
    {% render 'search-overlay' %}

    <div class="sr-only" id="sr-announcer" aria-live="polite" aria-atomic="true"></div>
    {%- if settings.grain -%}<div class="grain" aria-hidden="true"></div>{%- endif -%}
  </body>
</html>
