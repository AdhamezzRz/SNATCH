<dialog class="search" id="SearchOverlay" aria-label="{{ 'search.title' | t }}" data-search>
  <div class="search__inner">
    <div class="search__top">
      <form class="search__form" action="{{ routes.search_url }}" method="get" role="search">
        <input type="hidden" name="type" value="product">
        <label class="sr-only" for="SearchOverlayInput">{{ 'search.placeholder' | t }}</label>
        <input class="search__input" id="SearchOverlayInput" type="search" name="q" autocomplete="off" placeholder="{{ 'search.placeholder' | t }}" data-search-input>
      </form>
      <button type="button" class="hicon" data-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
    </div>
    <div class="search__hint" data-search-hint>
      <p class="label muted">{{ 'search.popular' | t }}</p>
      <ul role="list" class="search__terms">
        {%- assign terms = 'search.terms' | t | split: ',' -%}
        {%- for term in terms -%}<li><a href="{{ routes.search_url }}?type=product&q={{ term | strip | url_encode }}" data-term="{{ term | strip | escape }}">{{ term | strip }}</a></li>{%- endfor -%}
      </ul>
    </div>
    <div class="search__results" data-search-results aria-live="polite"></div>
  </div>
</dialog>
