{%- comment -%}
  Product card. Pass `product`, or `products` + `indices` ("4,5,6") to render a colourway family
  where the first index is the lead product.
  Accepts: product, products, indices, eager (bool), size ('feature' | '')
{%- endcomment -%}
{%- liquid
  if indices != blank
    assign idx = indices | split: ','
    assign lead_i = idx.first | plus: 0
    assign p = products[lead_i]
  else
    assign p = product
    assign idx = ''
  endif
  capture family
    render 'product-name', title: p.title, part: 'family'
  endcapture
  capture colour
    render 'product-name', title: p.title, part: 'colour'
  endcapture
  capture shape
    render 'silhouette', name: family
  endcapture
  assign family = family | strip
  assign colour = colour | strip
  assign shape = shape | strip
  assign loading = 'lazy'
  if eager
    assign loading = 'eager'
  endif
  assign img = p.featured_media.preview_image
  assign img2 = p.media[1].preview_image
  assign sizes = '(min-width: 1100px) 25vw, (min-width: 750px) 33vw, 50vw'
  if size == 'feature'
    assign sizes = '(min-width: 1100px) 50vw, 100vw'
  endif
  assign v = p.selected_or_first_available_variant
  capture families
    if idx.size > 1
      for i in idx
        assign mi = i | plus: 0
        assign m = products[mi]
        capture mc
          render 'product-name', title: m.title, part: 'colour'
        endcapture
        render 'colour-family', name: mc
        echo ' '
      endfor
    else
      render 'colour-family', name: colour
    endif
  endcapture
-%}
<article class="card{% if size != blank %} card--{{ size }}{% endif %}" data-card data-shape="{{ shape | handleize }}" data-shape-label="{{ shape | escape }}" data-colours="{{ families | strip | escape }}"{% if idx.size < 2 and colour != blank and settings.group_colorways %} data-family-fetch="{{ family | escape }}"{% endif %}>
  <div class="card__frame">
  <a class="card__media stage" href="{{ p.url }}" data-card-link tabindex="-1" aria-hidden="true" style="view-transition-name: p-{{ p.id }}">
    {%- if img -%}
      {{ img | image_url: width: 1200 | image_tag: loading: loading, sizes: sizes, widths: '360, 540, 720, 900, 1200', class: 'card__img', alt: p.title, data-card-img: '' }}
      {%- if img2 -%}
        {{ img2 | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: sizes, widths: '360, 540, 720, 900, 1200', class: 'card__img card__img--alt', alt: '', data-card-alt: '' }}
      {%- endif -%}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'card__placeholder' }}
    {%- endif -%}
    {%- unless p.available -%}<span class="card__flag">{{ 'products.sold_out' | t }}</span>{%- endunless -%}
  </a>
  {%- if settings.quick_add and p.has_only_default_variant -%}
    <button type="button" class="card__add" data-quick-add data-variant="{{ v.id }}" {% unless v.available %}disabled{% endunless %} aria-label="{{ 'products.quick_add' | t: title: p.title | escape }}" data-label-template="{{ 'products.quick_add' | t: title: '__T__' | escape }}">
      {% render 'icon', name: 'plus' %}<span class="card__add-text">{{ 'products.add' | t }}</span>
    </button>
  {%- endif -%}
  </div>
  <div class="card__meta">
    <h3 class="card__title"><a href="{{ p.url }}" data-card-link data-card-title>{{ family }}</a></h3>
    <p class="card__sub"><span data-card-colour>{{ colour | default: shape }}</span>{%- if idx.size > 1 -%}<span class="card__count"> · {{ 'general.colours' | t: count: idx.size }}</span>{%- endif -%}</p>
    <p class="card__price">{% render 'price', product: p %}</p>
    {%- if idx.size > 1 -%}
      <ul class="dots" role="list" data-dots>
        {%- for i in idx limit: 7 -%}
          {%- assign mi = i | plus: 0 -%}{%- assign m = products[mi] -%}
          {%- capture m_colour -%}{%- render 'product-name', title: m.title, part: 'colour' -%}{%- endcapture -%}
          {%- assign m_colour = m_colour | strip | default: m.title -%}
          {%- capture m_fam -%}{%- render 'colour-family', name: m_colour -%}{%- endcapture -%}
          {%- assign mv = m.selected_or_first_available_variant -%}
          <li>
            <a class="dot{% if forloop.first %} is-active{% endif %}" href="{{ m.url }}"
              style="--dot: {% render 'swatch-color', name: m_colour %}"
              data-dot
              data-colour="{{ m_colour | escape }}"
              data-fam="{{ m_fam | strip }}"
              data-variant="{{ mv.id }}"
              data-available="{{ mv.available }}"
              data-title="{{ m.title | escape }}"
              data-img="{{ m.featured_media.preview_image | image_url: width: 900 }}"
              data-srcset="{{ m.featured_media.preview_image | image_url: width: 540 }} 540w, {{ m.featured_media.preview_image | image_url: width: 900 }} 900w, {{ m.featured_media.preview_image | image_url: width: 1200 }} 1200w"
              {%- if m.media[1] %} data-img2="{{ m.media[1].preview_image | image_url: width: 900 }}"{% endif %}
              data-price="{{ m.price | money | escape }}"
              aria-label="{{ family | escape }} – {{ m_colour | escape }}"></a>
          </li>
        {%- endfor -%}
        {%- if idx.size > 7 -%}<li class="dots__more">+{{ idx.size | minus: 7 }}</li>{%- endif -%}
      </ul>
    {%- endif -%}
  </div>
</article>
