<style>
  @font-face {
    font-family: 'Marcellus';
    src: url({{ 'marcellus.woff2' | asset_url }}) format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Instrument Sans';
    src: url({{ 'instrument-sans.woff2' | asset_url }}) format('woff2-variations'), url({{ 'instrument-sans.woff2' | asset_url }}) format('woff2');
    font-weight: 400 700;
    font-style: normal;
    font-display: swap;
  }
  :root {
    --paper: {{ settings.color_paper }};
    --stone: {{ settings.color_stone }};
    --ink: {{ settings.color_ink }};
    --muted: {{ settings.color_muted }};
    --line: {{ settings.color_line }};
    --wine: {{ settings.color_wine }};
    --logo-w: {{ settings.logo_width }}px;
  }
  {%- if settings.page_transitions %}
  @media (prefers-reduced-motion: no-preference) {
    @view-transition { navigation: auto; }
  }
  {%- endif %}
</style>
