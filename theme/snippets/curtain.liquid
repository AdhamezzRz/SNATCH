<div class="curtain" aria-hidden="true" data-curtain>
  <div class="curtain__panel curtain__panel--l"></div>
  <div class="curtain__panel curtain__panel--r"></div>
  <div class="curtain__inner">
    {% render 'wordmark', class: 'curtain__mark' %}
    <div class="curtain__meta t-mono">
      <span>Cairo</span>
      <span class="curtain__count" data-curtain-count>000</span>
      <span>After hours</span>
    </div>
  </div>
</div>
