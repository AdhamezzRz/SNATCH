<dialog class="sheet" id="CartDrawer" aria-labelledby="CartDrawerTitle" data-cart-drawer>
  <div class="sheet__panel">
    <span class="sheet__grip" aria-hidden="true"></span>
    <header class="sheet__head">
      <h2 class="sheet__title" id="CartDrawerTitle">{{ 'cart.title' | t }} <sup data-cart-count-label>{{ cart.item_count }}</sup></h2>
      <button type="button" class="hicon" data-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
    </header>
    <div class="sheet__body" data-cart-body aria-busy="false">
      {% render 'cart-lines' %}
    </div>
    <footer class="sheet__foot" data-cart-foot {% if cart.item_count == 0 %}hidden{% endif %}>
      <div class="total">
        <span class="label">{{ 'cart.subtotal' | t }}</span>
        <span class="total__amount" data-cart-total>{{ cart.total_price | money }}</span>
      </div>
      <p class="small muted">{{ 'cart.taxes_note' | t }}</p>
      {%- if settings.cod_note != blank -%}<p class="cod">{% render 'icon', name: 'cash' %}<span>{{ settings.cod_note | escape }}</span></p>{%- endif -%}
      <form action="{{ routes.cart_url }}" method="post">
        <button type="submit" name="checkout" class="btn btn--wine btn--block"><span>{{ 'cart.checkout' | t }}</span>{% render 'icon', name: 'arrow' %}</button>
      </form>
      <button type="button" class="sheet__cont" data-close>{{ 'cart.continue' | t }}</button>
    </footer>
    <p class="sr-only" data-cart-status aria-live="polite" aria-atomic="true"></p>
  </div>
</dialog>
