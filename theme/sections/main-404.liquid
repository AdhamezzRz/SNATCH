<section class="closing closing--404" data-spotlight style="--veil: 0.85;">
  <div class="closing__media">
    {%- if section.settings.image != blank -%}{{ section.settings.image | image_url: width: 2000 | image_tag: loading: 'eager', sizes: '100vw', widths: '800, 1200, 1600, 2000', alt: '', class: 'closing__img' }}{%- endif -%}
  </div>
  <div class="hero__veil" aria-hidden="true"></div>
  <div class="closing__content">
    <p class="t-mono">404</p>
    <h1 class="t-mega closing__title">{{ section.settings.heading | escape }}</h1>
    <p class="closing__text">{{ section.settings.text | escape }}</p>
    <a class="btn btn--primary" href="{{ routes.all_products_collection_url }}"><span class="btn__label">{{ section.settings.button | escape }}</span>{% render 'icon', name: 'arrow' %}</a>
  </div>
</section>
{% schema %}
{
  "name": "404",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Already snatched." },
    { "type": "text", "id": "text", "label": "Text", "default": "Whatever was here is gone. The vault is still open, though." },
    { "type": "text", "id": "button", "label": "Button", "default": "Back to the vault" }
  ]
}
{% endschema %}
