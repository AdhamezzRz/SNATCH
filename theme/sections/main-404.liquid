<section class="center-page">
  <p class="label muted">404</p>
  <h1 class="t-display">{{ section.settings.heading | escape }}</h1>
  <p class="muted">{{ section.settings.text | escape }}</p>
  <a class="btn btn--primary" href="{{ routes.all_products_collection_url }}">{{ section.settings.button | escape }}</a>
</section>
{% schema %}
{
  "name": "404",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "This page has moved on." },
    { "type": "text", "id": "text", "label": "Text", "default": "The bag you were looking for might be in a new colour. Have a look around." },
    { "type": "text", "id": "button", "label": "Button", "default": "Shop all bags" }
  ]
}
{% endschema %}
