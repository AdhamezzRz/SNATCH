{%- assign p = section.settings.product -%}
<section class="feature{% if section.settings.flip %} feature--flip{% endif %}" aria-labelledby="FeatureTitle-{{ section.id }}">
  <div class="feature__media" data-clip>
    <div class="feature__frame" data-parallax="12">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 58vw, 100vw', widths: '600, 900, 1200, 1500, 1800', alt: section.settings.image.alt, class: 'feature__img' }}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'feature__img placeholder' }}
      {%- endif -%}
    </div>
    {%- if section.settings.caption != blank -%}<p class="feature__caption t-mono">{{ section.settings.caption | escape }}</p>{%- endif -%}
  </div>
  <div class="feature__copy">
    <h2 class="t-display feature__title" id="FeatureTitle-{{ section.id }}" data-reveal>{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.text != blank -%}<div class="feature__text rte" data-reveal>{{ section.settings.text }}</div>{%- endif -%}
    {%- if p != blank -%}
      {%- capture fam -%}{%- render 'product-name', title: p.title, part: 'family' -%}{%- endcapture -%}
      {%- capture col -%}{%- render 'product-name', title: p.title, part: 'colour' -%}{%- endcapture -%}
      <a class="mini" href="{{ p.url }}" data-reveal data-spot>
        <span class="mini__media lightbox">{{ p.featured_media.preview_image | image_url: width: 300 | image_tag: loading: 'lazy', alt: '' }}</span>
        <span class="mini__info">
          <span class="mini__name">{{ fam | strip }}</span>
          <span class="t-mono mini__meta">{{ col | strip }}</span>
          <span class="mini__price">{{ p.price | money }}</span>
        </span>
        <span class="mini__cta t-label">{{ section.settings.button_label | escape }} {% render 'icon', name: 'arrow' %}</span>
      </a>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Feature story",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "caption", "label": "Image caption", "default": "Exhibit A — 23:58" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Caught in the act." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Glossy, slouchy, impossible to ignore. The kind of bag people notice before they notice you, and then can't stop looking.</p>" },
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "button_label", "label": "Product link label", "default": "Snatch it" },
    { "type": "checkbox", "id": "flip", "label": "Image on the right", "default": false }
  ],
  "presets": [{ "name": "Feature story" }]
}
{% endschema %}
