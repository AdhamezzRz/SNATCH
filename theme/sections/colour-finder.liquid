{%- liquid
  assign first = section.blocks.first.settings.product
  capture fam
    if first != blank
      render 'product-name', title: first.title, part: 'family'
    endif
  endcapture
-%}
<section class="finder section" data-finder aria-labelledby="FinderTitle-{{ section.id }}">
  <div class="finder__stage stage" data-finder-stage aria-live="polite">
    {%- for block in section.blocks -%}
      {%- assign p = block.settings.product -%}
      {%- if p != blank -%}
        <figure class="finder__slide{% if forloop.first %} is-active{% endif %}" data-finder-slide {% unless forloop.first %}aria-hidden="true"{% endunless %} {{ block.shopify_attributes }}>
          {{ p.featured_media.preview_image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 50vw, 100vw', widths: '600, 900, 1200, 1400', alt: p.title }}
        </figure>
      {%- endif -%}
    {%- endfor -%}
  </div>
  <div class="finder__copy">
    <h2 class="t-h2" id="FinderTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.text != blank -%}<p class="muted">{{ section.settings.text | escape }}</p>{%- endif -%}
    <div class="finder__product">
      <p class="finder__name">{{ fam | strip }}</p>
      <p class="finder__price" data-finder-price>{% if first != blank %}{{ first.price | money }}{% endif %}</p>
    </div>
    <fieldset class="finder__swatches">
      <legend class="label">{{ 'products.colour' | t }}: <span data-finder-colour></span></legend>
      <div class="finder__options">
        {%- for block in section.blocks -%}
          {%- assign p = block.settings.product -%}
          {%- if p != blank -%}
            {%- capture col -%}{%- render 'product-name', title: p.title, part: 'colour' -%}{%- endcapture -%}
            {%- assign col = col | strip | default: p.title -%}
            {%- assign pv = p.selected_or_first_available_variant -%}
            <label class="swatch" title="{{ col | escape }}">
              <input type="radio" name="finder-{{ section.id }}" value="{{ forloop.index0 }}" {% if forloop.first %}checked{% endif %}
                data-finder-input data-colour="{{ col | escape }}" data-url="{{ p.url }}" data-price="{{ p.price | money | escape }}" data-variant="{{ pv.id }}" data-available="{{ pv.available }}">
              <span class="swatch__dot" style="--dot: {% render 'swatch-color', name: col %}"></span>
              <span class="sr-only">{{ col }}</span>
            </label>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </fieldset>
    <div class="finder__actions">
      <button type="button" class="btn btn--primary" data-finder-add {% if first.selected_or_first_available_variant.available == false %}disabled{% endif %}>{{ 'products.add_to_bag' | t }}</button>
      <a class="btn btn--secondary" href="{{ first.url }}" data-finder-link>{{ section.settings.details_label | escape }}</a>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Colour finder",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "One bag, every mood." },
    { "type": "text", "id": "text", "label": "Text", "default": "Tap a colour to see it. Add it to your bag without leaving the page." },
    { "type": "text", "id": "details_label", "label": "Details link label", "default": "View details" }
  ],
  "blocks": [
    { "type": "colour", "name": "Colour", "settings": [{ "type": "product", "id": "product", "label": "Product" }] }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Colour finder", "blocks": [{ "type": "colour" }, { "type": "colour" }, { "type": "colour" }] }]
}
{% endschema %}
