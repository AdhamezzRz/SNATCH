{%- liquid
  assign current = product.selected_or_first_available_variant
  capture family
    render 'product-name', title: product.title, part: 'family'
  endcapture
  capture colour
    render 'product-name', title: product.title, part: 'colour'
  endcapture
  capture shape
    render 'silhouette', name: family
  endcapture
  assign family = family | strip
  assign colour = colour | strip
  assign shape = shape | strip
  assign total = product.media.size
-%}
<section class="pdp" data-pdp data-family="{{ family | escape }}">
  <div class="pdp__gallery">
    <ul class="pdp__media" role="list" data-pdp-media aria-label="{{ 'products.gallery' | t }}">
      {%- for media in product.media -%}
        <li class="pdp__slide stage" {% if forloop.first %}style="view-transition-name: p-{{ product.id }}"{% endif %}>
          {%- case media.media_type -%}
            {%- when 'image' -%}
              {%- liquid
                assign m_loading = 'lazy'
                assign m_priority = 'auto'
                if forloop.first
                  assign m_loading = 'eager'
                  assign m_priority = 'high'
                endif
                assign m_alt = media.alt | default: product.title
              -%}
              <button type="button" class="pdp__zoom" data-zoom="{{ forloop.index0 }}" aria-label="{{ 'products.zoom' | t }}">
                {{ media | image_url: width: 2000 | image_tag: loading: m_loading, sizes: '(min-width: 990px) 56vw, 100vw', widths: '600, 900, 1200, 1600, 2000', alt: m_alt, fetchpriority: m_priority }}
              </button>
            {%- when 'video' -%}
              {{ media | video_tag: controls: true, muted: true, playsinline: true, image_size: '1200x' }}
            {%- when 'external_video' -%}
              {{ media | external_video_tag }}
            {%- else -%}
              {{ media | media_tag }}
          {%- endcase -%}
        </li>
      {%- else -%}
        <li class="pdp__slide stage">{{ 'product-1' | placeholder_svg_tag }}</li>
      {%- endfor -%}
    </ul>
    {%- if total > 1 -%}
      <p class="pdp__counter" aria-hidden="true"><span data-pdp-index>1</span> / {{ total }}</p>
    {%- endif -%}
  </div>

  <div class="pdp__info">
    <div class="pdp__sticky">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a><span aria-hidden="true">/</span>
        <a href="{{ routes.all_products_collection_url }}?shape={{ shape | handleize }}">{{ shape }}</a>
      </nav>
      <h1 class="pdp__title" data-split>{{ family }}</h1>
      <div class="pdp__line">
        {%- if colour != blank -%}<span class="pdp__colour">{{ colour }}</span>{%- endif -%}
        <span class="pdp__price">{% render 'price', product: product %}</span>
      </div>

      <div class="pdp__colours" data-siblings hidden>
        <p class="label">{{ 'products.colours_title' | t }} <span class="muted" data-sib-name>{{ colour }}</span></p>
        <ul class="swatches" role="list" data-sibling-list></ul>
      </div>

      {%- form 'product', product, class: 'pdp__form', data-product-form: '', novalidate: 'novalidate' -%}
        <input type="hidden" name="id" value="{{ current.id }}" data-variant-id>
        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <fieldset class="opt" data-option="{{ forloop.index0 }}">
              <legend class="label">{{ option.name }}</legend>
              <div class="opt__values">
                {%- for value in option.values -%}
                  <label class="opt__pill">
                    <input type="radio" name="option-{{ forloop.parentloop.index0 }}" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %} data-option-input>
                    <span>{{ value }}</span>
                  </label>
                {%- endfor -%}
              </div>
            </fieldset>
          {%- endfor -%}
          <script type="application/json" data-variants>{{ product.variants | json }}</script>
        {%- endunless -%}
        <input type="hidden" name="quantity" value="1">
        <button type="submit" name="add" class="btn btn--wine btn--block btn--tall" data-add {% unless current.available %}disabled{% endunless %}>
          <span data-add-label>{% if current.available %}{{ 'products.add_to_bag' | t }}{% else %}{{ 'products.sold_out' | t }}{% endif %}</span>
          <span class="btn__price" data-add-price>{{ current.price | money }}</span>
        </button>
        {%- if settings.show_dynamic_checkout -%}
          <div class="pdp__express">{{ form | payment_button }}</div>
        {%- endif -%}
        {%- if settings.cod_note != blank -%}<p class="cod">{% render 'icon', name: 'cash' %}<span>{{ settings.cod_note | escape }}</span></p>{%- endif -%}
        <p class="form-err" role="alert" data-form-error hidden></p>
      {%- endform -%}

      <div class="acc">
        {%- if product.description != blank -%}
          <details class="acc__item" open>
            <summary class="acc__sum">{{ 'products.details' | t }}<span class="acc__icon" aria-hidden="true"></span></summary>
            <div class="acc__body rte">{{ product.description }}</div>
          </details>
        {%- endif -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.title != blank -%}
            <details class="acc__item" {{ block.shopify_attributes }}>
              <summary class="acc__sum">{{ block.settings.title | escape }}<span class="acc__icon" aria-hidden="true"></span></summary>
              <div class="acc__body rte">{{ block.settings.content }}{%- if block.settings.page != blank -%}{{ block.settings.page.content }}{%- endif -%}</div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- if current.sku != blank -%}<p class="pdp__sku">{{ current.sku }}</p>{%- endif -%}
    </div>
  </div>

  <div class="pdp__bar" data-pdp-bar aria-hidden="true">
    <div class="pdp__bar-info"><span class="pdp__bar-name">{{ family }}</span><span class="pdp__bar-meta">{{ colour }} · {{ current.price | money }}</span></div>
    <button type="button" class="btn btn--wine" data-bar-add tabindex="-1" {% unless current.available %}disabled{% endunless %}>
      {%- if current.available -%}{{ 'products.add_to_bag' | t }}{%- else -%}{{ 'products.sold_out' | t }}{%- endif -%}
    </button>
  </div>

  <dialog class="zoom" data-zoom-dialog aria-label="{{ 'products.zoom' | t }}">
    <button type="button" class="hicon zoom__close" data-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
    <ul class="zoom__track" role="list" data-zoom-track>
      {%- for media in product.media -%}
        {%- if media.media_type == 'image' -%}
          {%- assign z_alt = media.alt | default: product.title -%}
          <li class="zoom__slide">{{ media | image_url: width: 2400 | image_tag: loading: 'lazy', sizes: '100vw', widths: '1200, 1800, 2400', alt: z_alt }}</li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </dialog>
</section>

<script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ request.origin | append: product.url | json }},
    {%- if product.featured_image -%}"image": [{{ product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }}],{%- endif -%}
    "description": {{ product.description | strip_html | json }},
    "sku": {{ current.sku | json }},
    "brand": { "@type": "Brand", "name": {{ shop.name | json }} },
    "offers": {
      "@type": "Offer",
      "url": {{ request.origin | append: current.url | json }},
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "price": {{ current.price | divided_by: 100.0 | json }},
      "availability": "http://schema.org/{% if current.available %}InStock{% else %}OutOfStock{% endif %}"
    }
  }
</script>
{% schema %}
{
  "name": "Product",
  "class": "section-pdp",
  "blocks": [
    {
      "type": "collapsible",
      "name": "Collapsible row",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Delivery & returns" },
        { "type": "richtext", "id": "content", "label": "Content" },
        { "type": "page", "id": "page", "label": "Page content" }
      ]
    }
  ]
}
{% endschema %}
