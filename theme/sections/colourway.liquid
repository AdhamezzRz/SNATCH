{%- liquid
  assign first = section.blocks.first.settings.product
  capture fam
    if first != blank
      render 'product-name', title: first.title, part: 'family'
    endif
  endcapture
  assign heading = section.settings.heading | default: fam
-%}
<section class="cway" data-cway aria-labelledby="CwayTitle-{{ section.id }}" style="--tint: #5E1724">
  <div class="cway__bg" aria-hidden="true"></div>
  <div class="cway__grid">
    <div class="cway__copy">
      <p class="t-mono cway__kicker">{{ section.settings.kicker | escape }}</p>
      <h2 class="t-display cway__title" id="CwayTitle-{{ section.id }}" data-reveal>{{ heading | strip | escape }}</h2>
      {%- if section.settings.text != blank -%}<p class="cway__text">{{ section.settings.text | escape }}</p>{%- endif -%}
      <fieldset class="cway__swatches">
        <legend class="t-label">{{ 'products.colourway' | t }}</legend>
        {%- for block in section.blocks -%}
          {%- assign p = block.settings.product -%}
          {%- if p != blank -%}
            {%- capture col -%}{%- render 'product-name', title: p.title, part: 'colour' -%}{%- endcapture -%}
            {%- assign col = col | strip | default: p.title -%}
            <label class="cway__swatch" {{ block.shopify_attributes }}>
              <input type="radio" name="cway-{{ section.id }}" value="{{ forloop.index0 }}" {% if forloop.first %}checked{% endif %} data-cway-input>
              <span class="dot dot--lg" style="--dot: {% render 'swatch-color', name: col %}" aria-hidden="true"></span>
              <span class="cway__swatch-name">{{ col | escape }}</span>
            </label>
          {%- endif -%}
        {%- endfor -%}
      </fieldset>
      <div class="cway__buy">
        <span class="cway__price" data-cway-price>{% if first != blank %}{{ first.price | money }}{% endif %}</span>
        <a class="btn btn--primary" href="{{ first.url }}" data-cway-link data-magnetic><span class="btn__label">{{ section.settings.button_label | escape }}</span>{% render 'icon', name: 'arrow' %}</a>
      </div>
      <button type="button" class="cway__toggle t-label" data-cway-toggle aria-pressed="false">{% render 'icon', name: 'pause' %}<span>{{ 'general.pause' | t }}</span></button>
    </div>
    <div class="cway__stage" aria-live="off" data-cway-stage>
      <div class="cway__pool" aria-hidden="true"></div>
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        {%- if p != blank -%}
          {%- capture col -%}{%- render 'product-name', title: p.title, part: 'colour' -%}{%- endcapture -%}
          <figure class="cway__slide{% if forloop.first %} is-active{% endif %}" data-cway-slide
            data-tint="{{ block.settings.tint }}" data-url="{{ p.url }}" data-price="{{ p.price | money | escape }}"
            {% unless forloop.first %}aria-hidden="true"{% endunless %}>
            {{ p.featured_media.preview_image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 50vw, 90vw', widths: '600, 900, 1200, 1400', alt: p.title, class: 'cway__img' }}
            <figcaption class="sr-only">{{ col | strip }}</figcaption>
          </figure>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Colourway switcher",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Label", "default": "One silhouette. Many alibis." },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave empty to use the style name of the first product." },
    { "type": "text", "id": "text", "label": "Text", "default": "Same belted shape, a different mood for every night of the week. Pick your alibi." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Take this one" }
  ],
  "blocks": [
    {
      "type": "colourway",
      "name": "Colourway",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "color", "id": "tint", "label": "Room tint", "default": "#5E1724" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Colourway switcher", "blocks": [{ "type": "colourway" }, { "type": "colourway" }, { "type": "colourway" }] }]
}
{% endschema %}
