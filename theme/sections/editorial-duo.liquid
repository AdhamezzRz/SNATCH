<section class="duo" aria-labelledby="Duo-{{ section.id }}">
  <h2 class="duo__title t-display" id="Duo-{{ section.id }}" data-split>{{ section.settings.heading | escape }}</h2>
  <div class="duo__grid">
    {%- for block in section.blocks -%}
      <a class="duo__item duo__item--{{ forloop.index }}" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
        <div class="duo__media" data-reveal-img>
          <div class="duo__frame" data-parallax="8">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 46vw, 100vw', widths: '500, 800, 1100, 1600', alt: block.settings.image.alt }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}
            {%- endif -%}
          </div>
        </div>
        <div class="duo__cap">
          <span class="duo__k">{{ block.settings.label | escape }}</span>
          <span class="duo__t">{{ block.settings.title | escape }}</span>
          <span class="duo__go">{{ block.settings.link_label | escape }} {% render 'icon', name: 'arrow' %}</span>
        </div>
      </a>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "Editorial duo",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Day to night, Cairo." }
  ],
  "blocks": [
    {
      "type": "story",
      "name": "Story",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "label", "label": "Label", "default": "Zamalek, 17:12" },
        { "type": "text", "id": "title", "label": "Title", "default": "Day bags" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop totes" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 2,
  "presets": [{ "name": "Editorial duo", "blocks": [{ "type": "story" }, { "type": "story" }] }]
}
{% endschema %}
