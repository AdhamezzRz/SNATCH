<footer class="footer">
  <div class="footer__grid">
    <div class="footer__brand">
      {% render 'logo-snatch', class: 'footer__logo' %}
      {%- if section.settings.text != blank -%}<p class="muted">{{ section.settings.text | escape }}</p>{%- endif -%}
      {%- form 'customer', class: 'news' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p class="news__ok" role="status">{{ 'newsletter.success' | t }}</p>
        {%- else -%}
          <label class="label" for="NewsEmail-{{ section.id }}">{{ section.settings.heading | escape }}</label>
          <div class="news__row">
            <input class="field" id="NewsEmail-{{ section.id }}" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'newsletter.placeholder' | t }}"{% if form.errors %} aria-invalid="true" aria-describedby="NewsErr-{{ section.id }}"{% endif %}>
            <button class="btn btn--primary" type="submit">{{ 'newsletter.submit' | t }}</button>
          </div>
          {%- if form.errors -%}<p class="form-err" id="NewsErr-{{ section.id }}">{{ form.errors | default_errors }}</p>{%- endif -%}
        {%- endif -%}
      {%- endform -%}
    </div>
    {%- for block in section.blocks -%}
      {%- assign menu = linklists[block.settings.menu] -%}
      <nav class="footer__col" {{ block.shopify_attributes }} aria-label="{{ block.settings.title | escape }}">
        <h3 class="label">{{ block.settings.title | escape }}</h3>
        <ul role="list">
          {%- for link in menu.links -%}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{%- endfor -%}
        </ul>
      </nav>
    {%- endfor -%}
    <div class="footer__col">
      <h3 class="label">{{ section.settings.social_title | escape }}</h3>
      <ul role="list">
        {%- if settings.social_instagram != blank -%}<li><a href="{{ settings.social_instagram }}" target="_blank" rel="noopener">Instagram</a></li>{%- endif -%}
        {%- if settings.social_tiktok != blank -%}<li><a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener">TikTok</a></li>{%- endif -%}
        {%- if settings.social_facebook != blank -%}<li><a href="{{ settings.social_facebook }}" target="_blank" rel="noopener">Facebook</a></li>{%- endif -%}
        {%- if settings.social_whatsapp != blank -%}<li><a href="{{ settings.social_whatsapp }}" target="_blank" rel="noopener">WhatsApp</a></li>{%- endif -%}
        {%- for policy in shop.policies -%}<li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>{%- endfor -%}
      </ul>
    </div>
  </div>
  <div class="footer__base">
    <span class="small muted">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
    <ul class="footer__pay" role="list">
      {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag: class: 'pay-icon' }}</li>{%- endfor -%}
    </ul>
  </div>
</footer>
{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "settings": [
    { "type": "text", "id": "text", "label": "Brand line", "default": "Handbags, edited in Cairo." },
    { "type": "text", "id": "heading", "label": "Newsletter label", "default": "Get new arrivals first" },
    { "type": "text", "id": "social_title", "label": "Last column title", "default": "Info" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    }
  ]
}
{% endschema %}
