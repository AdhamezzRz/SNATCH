<footer class="footer" data-footer>
  <div class="footer__top">
    <div class="footer__news">
      <h2 class="footer__title t-h2" data-reveal>{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<p class="footer__text">{{ section.settings.text | escape }}</p>{%- endif -%}
      {%- form 'customer', class: 'news' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p class="news__ok t-mono" role="status">{{ 'newsletter.success' | t }}</p>
        {%- else -%}
          <label class="sr-only" for="NewsEmail-{{ section.id }}">{{ 'newsletter.label' | t }}</label>
          <input class="news__input" id="NewsEmail-{{ section.id }}" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'newsletter.placeholder' | t }}"{% if form.errors %} aria-invalid="true" aria-describedby="NewsErr-{{ section.id }}"{% endif %}>
          <button class="news__btn t-label" type="submit">{{ 'newsletter.submit' | t }} {% render 'icon', name: 'arrow' %}</button>
          {%- if form.errors -%}<p class="news__err t-mono" id="NewsErr-{{ section.id }}">{{ form.errors | default_errors }}</p>{%- endif -%}
        {%- endif -%}
      {%- endform -%}
    </div>
    <div class="footer__cols">
      {%- for block in section.blocks -%}
        {%- assign menu = linklists[block.settings.menu] -%}
        <nav class="footer__col" {{ block.shopify_attributes }} aria-label="{{ block.settings.title | escape }}">
          <h3 class="t-label footer__col-title">{{ block.settings.title | escape }}</h3>
          <ul role="list">
            {%- for link in menu.links -%}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{%- endfor -%}
          </ul>
        </nav>
      {%- endfor -%}
      <div class="footer__col">
        <h3 class="t-label footer__col-title">{{ section.settings.social_title | escape }}</h3>
        <ul role="list" class="footer__social">
          {%- if settings.social_instagram != blank -%}<li><a href="{{ settings.social_instagram }}" target="_blank" rel="noopener">{% render 'icon', name: 'instagram' %}<span>Instagram</span></a></li>{%- endif -%}
          {%- if settings.social_tiktok != blank -%}<li><a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener">{% render 'icon', name: 'tiktok' %}<span>TikTok</span></a></li>{%- endif -%}
          {%- if settings.social_facebook != blank -%}<li><a href="{{ settings.social_facebook }}" target="_blank" rel="noopener">{% render 'icon', name: 'facebook' %}<span>Facebook</span></a></li>{%- endif -%}
          {%- if settings.social_whatsapp != blank -%}<li><a href="{{ settings.social_whatsapp }}" target="_blank" rel="noopener">{% render 'icon', name: 'whatsapp' %}<span>WhatsApp</span></a></li>{%- endif -%}
          {%- for policy in shop.policies -%}<li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>{%- endfor -%}
        </ul>
      </div>
    </div>
  </div>
  <div class="footer__mark" data-footer-mark>
    {% render 'wordmark', class: 'footer__wordmark' %}
  </div>
  <div class="footer__base t-mono">
    <span>&copy; {{ 'now' | date: '%Y' }} <a href="{{ routes.root_url }}">{{ shop.name }}</a></span>
    <span class="footer__tag">{{ section.settings.tagline | escape }}</span>
    <ul class="footer__pay" role="list">
      {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag: class: 'pay-icon' }}</li>{%- endfor -%}
    </ul>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "settings": [
    { "type": "text", "id": "heading", "label": "Newsletter heading", "default": "Get the after-hours list." },
    { "type": "text", "id": "text", "label": "Newsletter text", "default": "New pieces go under the light first for the list. No noise, just the drop." },
    { "type": "text", "id": "social_title", "label": "Social column title", "default": "Elsewhere" },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Cairo · After hours" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "The vault" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    }
  ]
}
{% endschema %}
