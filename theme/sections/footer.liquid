<footer class="footer" data-header-theme="light">
  <div class="footer__top">
    <div class="footer__news">
      <h2 class="footer__title">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<p class="footer__text">{{ section.settings.text | escape }}</p>{%- endif -%}
      {%- form 'customer', class: 'news' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p class="news__ok" role="status">{{ 'newsletter.success' | t }}</p>
        {%- else -%}
          <label class="sr-only" for="NewsEmail-{{ section.id }}">{{ 'newsletter.label' | t }}</label>
          <input class="news__input" id="NewsEmail-{{ section.id }}" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'newsletter.placeholder' | t }}"{% if form.errors %} aria-invalid="true" aria-describedby="NewsErr-{{ section.id }}"{% endif %}>
          <button class="news__btn" type="submit">{{ 'newsletter.submit' | t }} {% render 'icon', name: 'arrow' %}</button>
          {%- if form.errors -%}<p class="news__err" id="NewsErr-{{ section.id }}">{{ form.errors | default_errors }}</p>{%- endif -%}
        {%- endif -%}
      {%- endform -%}
    </div>
    <div class="footer__cols">
      {%- for block in section.blocks -%}
        {%- assign menu = linklists[block.settings.menu] -%}
        <nav class="footer__col" {{ block.shopify_attributes }} aria-label="{{ block.settings.title | escape }}">
          <h3 class="footer__label">{{ block.settings.title | escape }}</h3>
          <ul role="list">
            {%- for link in menu.links -%}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{%- endfor -%}
          </ul>
        </nav>
      {%- endfor -%}
      <div class="footer__col">
        <h3 class="footer__label">{{ section.settings.social_title | escape }}</h3>
        <ul role="list">
          {%- if settings.social_instagram != blank -%}<li><a href="{{ settings.social_instagram }}" target="_blank" rel="noopener">Instagram</a></li>{%- endif -%}
          {%- if settings.social_tiktok != blank -%}<li><a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener">TikTok</a></li>{%- endif -%}
          {%- if settings.social_facebook != blank -%}<li><a href="{{ settings.social_facebook }}" target="_blank" rel="noopener">Facebook</a></li>{%- endif -%}
          {%- if settings.social_whatsapp != blank -%}<li><a href="{{ settings.social_whatsapp }}" target="_blank" rel="noopener">WhatsApp</a></li>{%- endif -%}
          {%- for policy in shop.policies -%}<li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>{%- endfor -%}
        </ul>
      </div>
    </div>
  </div>
  <div class="footer__logo" data-rise>{% render 'logo-snatch' %}</div>
  <div class="footer__base">
    <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
    <span>{{ section.settings.tagline | escape }}</span>
    {%- if section.settings.credit_label != blank -%}<span class="footer__credit">{{ section.settings.credit_text | escape }} <a href="{{ section.settings.credit_url | default: 'https://najmarketing.co' }}" target="_blank" rel="noopener">{{ section.settings.credit_label | escape }}</a></span>{%- endif -%}
    <ul class="footer__pay" role="list">
      {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag: class: 'pay-icon' }}</li>{%- endfor -%}
    </ul>
  </div>
</footer>
{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "settings": [
    { "type": "text", "id": "heading", "label": "Newsletter heading", "default": "First to know." },
    { "type": "text", "id": "text", "label": "Newsletter text", "default": "New styles and restocked colours, straight to your inbox. Nothing else." },
    { "type": "text", "id": "social_title", "label": "Last column title", "default": "Info" },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Snatch the fit." },
    { "type": "text", "id": "credit_text", "label": "Credit text", "default": "Powered by" },
    { "type": "text", "id": "credit_label", "label": "Credit name", "default": "najmarketing.co" },
    { "type": "text", "id": "credit_url", "label": "Credit link", "default": "https://najmarketing.co" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    }
  ]
}
{% endschema %}
