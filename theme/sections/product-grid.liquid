{%- liquid
  assign c = section.settings.collection
  if c == blank
    assign c = collections.all
  endif
  assign list = section.settings.products
-%}
<section class="pgrid section" aria-labelledby="GridTitle-{{ section.id }}">
  <header class="section__head">
    <h2 class="t-h2" id="GridTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.link_label != blank -%}
      <a class="link-arrow" href="{{ section.settings.link | default: c.url }}">{{ section.settings.link_label | escape }} {% render 'icon', name: 'arrow' %}</a>
    {%- endif -%}
  </header>
  <div class="grid" data-reveal-group>
    {%- if list != blank -%}
      {%- for p in list -%}{% render 'product-card', product: p %}{%- endfor -%}
    {%- else -%}
      {%- if section.settings.newest -%}
        {%- assign source = c.products | sort: 'created_at' | reverse -%}
      {%- else -%}
        {%- assign source = c.products -%}
      {%- endif -%}
      {% render 'family-grid', products: source, limit: section.settings.limit %}
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Product grid",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "New in" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Defaults to all products." },
    { "type": "product_list", "id": "products", "label": "Or pick products", "limit": 12 },
    { "type": "checkbox", "id": "newest", "label": "Newest first", "default": true },
    { "type": "range", "id": "limit", "label": "Styles to show", "min": 4, "max": 16, "step": 4, "default": 8 },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View all" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "Product grid" }]
}
{% endschema %}
