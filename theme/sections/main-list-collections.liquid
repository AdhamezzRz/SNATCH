<section class="plp">
  <header class="plp__head"><h1 class="t-mega plp__title" data-reveal>{{ page_title | escape }}</h1></header>
  <div class="cols">
    {%- for c in collections -%}
      <a class="colcard" href="{{ c.url }}" data-spot>
        <span class="colcard__media lightbox">
          {%- assign cimg = c.image | default: c.products.first.featured_media.preview_image -%}
          {%- if cimg -%}{{ cimg | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 33vw, 100vw', widths: '400, 600, 900', alt: c.title }}{%- endif -%}
        </span>
        <span class="colcard__title t-h3">{{ c.title | escape }}</span>
        <span class="t-mono">{{ 'general.pieces' | t: count: c.products_count }}</span>
      </a>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{ "name": "Collections list", "settings": [] }
{% endschema %}
