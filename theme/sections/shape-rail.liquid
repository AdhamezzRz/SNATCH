<section class="shapes section" aria-labelledby="ShapesTitle-{{ section.id }}">
  <header class="section__head">
    <h2 class="t-h2" id="ShapesTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
  </header>
  <ul class="shapes__list" role="list">
    {%- for block in section.blocks -%}
      {%- assign p = block.settings.product -%}
      <li {{ block.shopify_attributes }}>
        <a class="shape" href="{{ block.settings.link | default: routes.all_products_collection_url }}">
          <span class="shape__media stage">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 16vw, 40vw', widths: '300, 450, 600', alt: '' }}
            {%- elsif p != blank -%}
              {{ p.featured_media.preview_image | image_url: width: 600 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 16vw, 40vw', widths: '300, 450, 600', alt: '' }}
            {%- endif -%}
          </span>
          <span class="shape__label">{{ block.settings.label | escape }}</span>
        </a>
      </li>
    {%- endfor -%}
  </ul>
</section>
{% schema %}
{
  "name": "Shop by shape",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by shape" }
  ],
  "blocks": [
    {
      "type": "shape",
      "name": "Shape",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Totes" },
        { "type": "product", "id": "product", "label": "Product image from" },
        { "type": "image_picker", "id": "image", "label": "Or custom image" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Shop by shape", "blocks": [{ "type": "shape" }, { "type": "shape" }, { "type": "shape" }, { "type": "shape" }] }]
}
{% endschema %}
