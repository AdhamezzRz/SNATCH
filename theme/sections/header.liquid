{%- assign menu = linklists[section.settings.menu] -%}
{%- if section.settings.announcement != blank -%}
  <div class="announce">
    {%- if section.settings.announcement_link != blank -%}
      <a href="{{ section.settings.announcement_link }}">{{ section.settings.announcement | escape }} <span aria-hidden="true">→</span></a>
    {%- else -%}
      <p>{{ section.settings.announcement | escape }}</p>
    {%- endif -%}
  </div>
{%- endif -%}
<header class="header" data-header>
  <div class="header__bar">
    <div class="header__start">
      <button type="button" class="icon-btn header__burger" data-menu-open aria-controls="MenuDrawer" aria-label="{{ 'general.menu' | t }}">
        <span class="burger" aria-hidden="true"><i></i><i></i></span>
      </button>
      <a class="header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">{% render 'logo' %}</a>
    </div>
    <nav class="header__nav" aria-label="{{ 'general.menu' | t }}">
      <ul role="list">
        {%- for link in menu.links -%}
          <li><a class="nav-link" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>
        {%- endfor -%}
      </ul>
    </nav>
    <div class="header__end">
      <button type="button" class="icon-btn" data-search-open aria-label="{{ 'general.search' | t }}">{% render 'icon', name: 'search' %}</button>
      {%- if shop.customer_accounts_enabled -%}
        <a class="icon-btn hide-sm" href="{{ routes.account_url }}" aria-label="{{ 'general.account' | t }}">{% render 'icon', name: 'account' %}</a>
      {%- endif -%}
      <a class="icon-btn header__bag" href="{{ routes.cart_url }}" data-cart-open aria-label="{{ 'general.bag' | t }}">
        {% render 'icon', name: 'bag' %}
        <span class="header__count" data-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>
{% render 'menu-drawer', menu: menu %}
{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    { "type": "text", "id": "announcement", "label": "Announcement", "default": "New pieces added every week" },
    { "type": "url", "id": "announcement_link", "label": "Announcement link", "default": "/collections/all" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" }
  ]
}
{% endschema %}
