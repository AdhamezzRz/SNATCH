<article class="prose-page">
  <p class="t-mono">{{ article.published_at | date: '%d.%m.%Y' }}</p>
  <h1 class="t-display prose-page__title" data-reveal>{{ article.title | escape }}</h1>
  {%- if article.image -%}<div class="prose-page__image">{{ article.image | image_url: width: 1800 | image_tag: loading: 'eager', sizes: '100vw', widths: '800, 1200, 1800', alt: article.image.alt }}</div>{%- endif -%}
  <div class="rte prose">{{ article.content }}</div>
</article>
{% schema %}
{ "name": "Article", "settings": [] }
{% endschema %}
