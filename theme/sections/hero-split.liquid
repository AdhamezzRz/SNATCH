<section class="hsplit" aria-label="{{ section.settings.label | escape }}">
  {%- for block in section.blocks -%}
    <a class="hsplit__panel" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
      <div class="hsplit__media">
        {%- if block.settings.image != blank -%}
          {%- liquid
            assign loading = 'lazy'
            assign priority = 'auto'
            if forloop.first
              assign loading = 'eager'
              assign priority = 'high'
            endif
          -%}
          {{ block.settings.image | image_url: width: 1800 | image_tag: loading: loading, fetchpriority: priority, sizes: '(min-width: 750px) 50vw, 100vw', widths: '500, 750, 1000, 1400, 1800', alt: block.settings.image.alt, class: 'hsplit__img' }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'hsplit__img placeholder' }}
        {%- endif -%}
      </div>
      <div class="hsplit__copy">
        {%- if block.settings.heading != blank -%}
          {%- if forloop.first -%}<h1 class="hsplit__title">{{ block.settings.heading | escape }}</h1>{%- else -%}<h2 class="hsplit__title">{{ block.settings.heading | escape }}</h2>{%- endif -%}
        {%- endif -%}
        {%- if block.settings.text != blank -%}<p class="hsplit__text">{{ block.settings.text | escape }}</p>{%- endif -%}
        {%- if block.settings.button_label != blank -%}<span class="hsplit__cta">{{ block.settings.button_label | escape }} {% render 'icon', name: 'arrow' %}</span>{%- endif -%}
      </div>
    </a>
  {%- endfor -%}
</section>
{% schema %}
{
  "name": "Split hero",
  "settings": [
    { "type": "text", "id": "label", "label": "Accessible label", "default": "Featured edits" }
  ],
  "blocks": [
    {
      "type": "panel",
      "name": "Panel",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Day bags" },
        { "type": "text", "id": "text", "label": "Text", "default": "Totes and top handles that carry the whole day." },
        { "type": "text", "id": "button_label", "label": "Link label", "default": "Shop now" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 2,
  "presets": [{ "name": "Split hero", "blocks": [{ "type": "panel" }, { "type": "panel" }] }]
}
{% endschema %}
