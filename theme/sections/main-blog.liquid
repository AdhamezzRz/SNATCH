<section class="plp">
  <header class="plp__head"><h1 class="t-mega plp__title" data-reveal>{{ blog.title | escape }}</h1></header>
  {%- paginate blog.articles by 12 -%}
    <div class="cols">
      {%- for article in blog.articles -%}
        <a class="colcard" href="{{ article.url }}" data-spot>
          <span class="colcard__media lightbox--dark">{%- if article.image -%}{{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 33vw, 100vw', widths: '400, 600, 900', alt: article.image.alt }}{%- endif -%}</span>
          <span class="t-mono">{{ article.published_at | date: '%d.%m.%Y' }}</span>
          <span class="colcard__title t-h3">{{ article.title | escape }}</span>
        </a>
      {%- endfor -%}
    </div>
  {%- endpaginate -%}
</section>
{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
