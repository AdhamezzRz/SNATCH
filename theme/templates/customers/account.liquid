<section class="auth auth--wide">
  <h1 class="t-display">{{ 'general.account' | t }}</h1>
  <p><a class="label" href="{{ routes.account_logout_url }}">{{ 'customer.logout' | t }}</a> · <a class="label" href="{{ routes.account_addresses_url }}">{{ 'customer.addresses' | t }}</a></p>
  <h2 class="t-h3">{{ 'customer.orders' | t }}</h2>
  {%- if customer.orders.size == 0 -%}
    <p>{{ 'customer.no_orders' | t }}</p>
  {%- else -%}
    <table class="table">
      <thead><tr><th>{{ 'customer.order' | t }}</th><th>{{ 'customer.date' | t }}</th><th>{{ 'customer.status' | t }}</th><th>{{ 'customer.total' | t }}</th></tr></thead>
      <tbody>
        {%- for order in customer.orders -%}
          <tr><td><a href="{{ order.customer_url }}">{{ order.name }}</a></td><td>{{ order.created_at | date: '%d.%m.%Y' }}</td><td>{{ order.financial_status_label }}</td><td>{{ order.total_price | money }}</td></tr>
        {%- endfor -%}
      </tbody>
    </table>
  {%- endif -%}
</section>
