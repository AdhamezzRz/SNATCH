<section class="auth">
  <h1 class="t-display">{{ 'customer.reset' | t }}</h1>
  {%- form 'reset_customer_password', class: 'auth__form' -%}
    {%- if form.errors -%}<p class="form-err" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
    <label class="label" for="ResetPass">{{ 'customer.password' | t }}</label>
    <input class="field" id="ResetPass" type="password" name="customer[password]" autocomplete="new-password" required>
    <label class="label" for="ResetPass2">{{ 'customer.password' | t }}</label>
    <input class="field" id="ResetPass2" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
    <button class="btn btn--primary" type="submit"><span class="btn__label">{{ 'customer.reset' | t }}</span></button>
  {%- endform -%}
</section>
