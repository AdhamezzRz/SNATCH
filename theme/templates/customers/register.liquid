<section class="auth">
  <h1 class="t-display">{{ 'customer.register' | t }}</h1>
  {%- form 'create_customer', class: 'auth__form' -%}
    {%- if form.errors -%}<p class="form-err" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
    <label class="label" for="RegFirst">{{ 'customer.first_name' | t }}</label>
    <input class="field" id="RegFirst" type="text" name="customer[first_name]" autocomplete="given-name">
    <label class="label" for="RegLast">{{ 'customer.last_name' | t }}</label>
    <input class="field" id="RegLast" type="text" name="customer[last_name]" autocomplete="family-name">
    <label class="label" for="RegEmail">{{ 'customer.email' | t }}</label>
    <input class="field" id="RegEmail" type="email" name="customer[email]" autocomplete="email" required>
    <label class="label" for="RegPassword">{{ 'customer.password' | t }}</label>
    <input class="field" id="RegPassword" type="password" name="customer[password]" autocomplete="new-password" required>
    <button class="btn btn--primary" type="submit"><span class="btn__label">{{ 'customer.register' | t }}</span></button>
  {%- endform -%}
</section>
